itemId":920009631123,"name":"Гром","prop1":4,"prop2":2,"prop3":3,"prop4":3,"prop5":3,"specialtyImage":1667192182923,"specialtyName":"Разрывные снаряды","video":1700125403610},{"itemId":920009630941,"name":"Викинг","prop1":4,"prop2":4,"prop3":3,"prop4":3,"prop5":4,"specialtyImage":1668156934930,"specialtyName":"Берсерк-реактор","video":1690957167393},{"itemId":920009630969,"name":"Смоки","prop1":3,"prop2":3,"prop3":4,"prop4":3,"prop5":2,"specialtyImage":1667192182950,"specialtyName":"Универсальность","video":1700125403626},{"itemId":920009631088,"name":"Рикошет","prop1":2,"prop2":4,"prop3":5,"prop4":2,"prop5":3,"specialtyImage":1667192182930,"specialtyName":"Многократный рикошет","video":1700125403612},{"itemId":920009631123,"name":"Гром","prop1":4,"prop2":2,"prop3":3,"prop4":3,"prop5":3,"specialtyImage":1667192182923,"specialtyName":"Разрывные снаряды","video":1700125403610},{"itemId":920009631011,"name":"Рельса","prop1":5,"prop2":2,"prop3":2,"prop4":5,"prop5":4,"specialtyImage":1667192182948,"specialtyName":"Сквозное пробитие","video":1700125403609},{"itemId":920009630962,"name":"Диктатор","prop1":4,"prop2":4,"prop3":3,"prop4":4,"prop5":5,"specialtyImage":1668156934931,"specialtyName":"Перегрузка","video":1690956941928}],[920004704099,1931009779873,1931009779872,1931009779874,920004704216,1931009779875,920004704213,1931009779876,1931009779877,1931009779878,920004703972,920004703975,920004703974,1931009779879,1931009779880,1931009779881,920004703973,1931009779882],[{"description":"Являясь скорее данью традициям классического танкостроения, этот незамысловатый цвет, так полюбившийся конструкторам всего мира, стал своеобразным стандартом для заводских моделей. К этому легендарному цвету часто возвращаются истинные ценители, перепробовав всё на свете.","itemId":920004704099,"name":"Зелёный"},{"description":"Расцветка танков береговой охраны. Большое число транспортных контейнеров проще всего перемещать водными путями, а на большой груз всегда находится большой разбойник.","itemId":1931009779873,"name":"Морской"},{"description":"Если танк необходимо замаскировать на фоне растительности, то лучше использовать эту специальную расцветку. Стандартная зелёная расцветка является скорее данью традициям и хуже справляется с этой задачей.","itemId":1931009779872,"name":"Яблоко"},{"description":"Расцветка, разработанная для ховер-танков. Прототипы могли летать значительно выше и маскировка на фоне неба была практически необходима. Версии же для массового производства имеют оптимизированную высоту полёта на уровне традиционных танков и требуют стандартной маскировки. Покрытие, тем не менее закрепилось в официальном перечне.","itemId":1931009779874,"name":"Синева"},{"description":"Данная расцветка стала негласным стандартом для диверсионных танковых дивизий, основной задачей которых является скрытное проникновение на территорию врага в тёмное время суток. В армейских кругах танки из таких элитных дивизий за глаза с завистью называют «чёрные пятна смерти».","itemId":920004704216,"name":"Чёрный"},{"description":"Эту расцветку оставили в официальном перечне, как память о провалившемся проекте разработки танка-амфибии «Сом». По задумке конструкторов, он должен был передвигаться по руслам неглубоких рек, и, благодаря синей расцветке, беспрепятственно проникать в глубокий вражеский тыл, оставаясь незамеченным.","itemId":1931009779875,"name":"Синий"},{"description":"Специализированная расцветка для форсирования небольших рек. Имеет олеофобное покрытие, максимально быстро справляющееся с влагой на корпусе. Не защищает от солёной воды.","itemId":920004704213,"name":"Штиль"},{"description":"Ремонтное покрытие, упрощающее проведение спектрального и ультразвукового анализа трещин в броне. Если танк применяется в чрезвычайно тяжёлых температурных и радиационных условиях, то практический смысл этой краски в том, чтобы не перекрашивать танк между частым техническим обслуживанием.","itemId":1931009779876,"name":"Коралловый"},{"description":"Расцветка, по слухам, разработанная для битв в цветочных полях. Где найти такие поля — никто не знает, но сама идея их существования завораживает. Не имея практичного применения, эта расцветка стала символизировать мечту.","itemId":1931009779877,"name":"Фуксия"},{"description":"Расцветка, которую часто используют для тестовых образцов и машин технического обеспечения. Золотой цвет максимально привлекает внимание, даже если это просто краска. Игнорировать танки в этой расцветке считается плохим тоном.","itemId":1931009779878,"name":"Золотой"},{"description":"Воплощение ярости и отваги, обладает также природной практичностью, позволяя деликатно скрывать пятна вражеской крови, неизбежно появляющиеся на корпусе, как бы вы ни аккуратничали.","itemId":920004703972,"name":"Бордовый"},{"description":"Существует ошибочное мнение, что данной расцветкой пользуются в условиях дефицита лакокрасочных материалов. На самом деле — это специальное покрытие, особым образом отражающее свет. Бликовый шум, создаваемый таким покрытием, вносит помехи в работу некоторых систем наведения.","itemId":920004703975,"name":"Металлик"},{"description":"Шутка, зашедшая слишком далеко. Это действительно просто горчица, которой покрыт весь танк. Удивительно, но такая расцветка показала более высокую эффективность в пустыне, чем стандартная оранжевая. В рекомендациях к работе с этим покрытием не указано, что его нельзя использовать не по назначению.","itemId":920004703974,"name":"Горчичный"},{"description":"Данную расцветку не планировалось включать в официальный перечень, так как она не представляла особой практической ценности, кроме, быть может, посредственной маскировки в пустынной местности. Но армейские мозгоправы доказали, что оранжевый цвет положительно влияет на психологическое здоровье «пушечного мяса».","itemId":1931009779879,"name":"Оранжевый"},{"description":"Расцветка для по-настоящему командных танкистов. Лучший способ замаскировать своих союзников — это вызвать огонь на себя. Ярко-красная расцветка не оставляет противнику выбора и вводит его в бешенство.","itemId":1931009779880,"name":"Красный"},{"description":"Отличительная расцветка научно-исследовательских машин, собирающих информацию о погодных, радиационных и других изменениях в окружающем пространстве. Используется боевыми машинами во время сопровождения исследователей или для того, чтобы привлекать к себе меньше внимания на спорных территориях.","itemId":1931009779881,"name":"Индиго"},{"description":"Специальная разработка для проведения наземных операций в странах с холодным климатом. В заснеженной местности такая расцветка способна значительно снизить вероятность обнаружения. Ради увеличения объёмов продаж производитель включил в комплект поставки тёплый тулуп и валенки.","itemId":920004703973,"name":"Белый"},{"description":"Специальная расцветка дивизий «воинов востока», которые всегда атакуют своего противника заходя со стороны солнца. Ослепительное солнце переливается в расцветке миллионами бликов на восходе, и действительно снижает число попаданий по танку. Но только на восходе солнца.","itemId":1931009779882,"name":"Жёлтый"}],[38,38,40,40,37,39,37,39,66,65]]}],"complete":[{"object":"0000000005f691cc","method":"1c1d64bee176be15","name":"76be15","args":[3074457415747269434]}],"previews":{"920009631039":{"deps":{"classes":[{"id":"ffffffff8000038d","models":["1d57131a927722d4","67b1f230feef85f9","6359f96d6436ab99","380b82db98352886"]}],"resources":[{"id":1614588292448,"type":17,"subType":0,"version":1782198388085,"isLazy":false,"deps":[]}]},"data":{"objects":[{"id":"ffffffff8000038e","class":"ffffffff8000038d"}],"modelsData":[{"object":"ffffffff8000038e"},{"model":"1d57131a927722d4","data":{"category":"ARMOR"}},{"model":"67b1f230feef85f9","data":{"emissionColor":{"emissionColor":54754,"emissionColorBlue":0,"emissionColorRed":0,"emissionColorSecond":0,"threshold":"DEFAULT"},"itemId":920009631039,"leftTrackTexToWorldRatio":-0.007199999876320362,"resource":1614588292448,"rightTrackTexToWorldRatio":-0.007199